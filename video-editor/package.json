{
  "name": "clipcraft-video-editor",
  "productName": "ClipCraft",
  "version": "1.0.0",
  "description": "Desktop video editor: trim, join, text, music, filters, transitions and speed, exported with FFmpeg.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.js",
    "test:export": "node --test test/export.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "author": "ClipCraft",
  "build": {
    "appId": "app.clipcraft.editor",
    "productName": "ClipCraft",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "files": [
        "!node_modules/ffprobe-static/bin/{linux,win32}/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "files": [
        "!node_modules/ffprobe-static/bin/{darwin,win32}/**",
        "!node_modules/ffprobe-static/bin/linux/ia32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
