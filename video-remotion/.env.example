# Copy to .env (never commit .env) and fill in. See README: "פרסום אוטומטי".

# Instagram API with Instagram Login (professional account)
IG_ACCESS_TOKEN=
# Optional; "me" is used when empty
IG_USER_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
